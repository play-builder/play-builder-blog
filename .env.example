# Build-time Notion sync. Keep false for a normal local build.
NOTION_SYNC_ENABLED=false
NOTION_TOKEN=replace-in-local-env-or-cloudflare-secret
NOTION_COURSES_DATA_SOURCE_ID=replace-with-courses-data-source-id
NOTION_LESSONS_DATA_SOURCE_ID=replace-with-lessons-data-source-id

# Cloudflare Pages Functions runtime configuration.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-access-application-aud
ADMIN_ALLOWED_IPS=203.0.113.10
CLOUDFLARE_PAGES_DEPLOY_HOOK_URL=https://example.invalid/replace-with-deploy-hook

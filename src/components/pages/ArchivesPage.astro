---
import type { CollectionEntry } from "astro:content";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import { useTranslations } from "@/i18n";
import {
  CONTENT_LOCALES,
  otherLocale,
  type ContentLocale,
} from "@/i18n/locales";
import { sectionPath } from "@/i18n/urls";
import Layout from "@/layouts/Layout.astro";
import { getPostsByGroupCondition } from "@/pages/archives/_utils/getPostsByGroupCondition";
import config from "@/config";

const { locale, posts } = Astro.props as {
  locale: ContentLocale;
  posts: CollectionEntry<"posts">[];
};

if (!config.features.showArchives) {
  return Astro.rewrite(locale === "en" ? "/en/404/" : "/404/");
}

const t = useTranslations(locale);
const canonicalPath = sectionPath(locale, "archives");
const alternates = CONTENT_LOCALES.map(alternateLocale => ({
  locale: alternateLocale,
  href: sectionPath(alternateLocale, "archives"),
}));
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
---

<Layout
  locale={locale}
  title={`${t.pages.archivesTitle} | ${config.site.title}`}
  description={t.pages.archivesDesc}
  canonicalURL={new URL(canonicalPath, Astro.site ?? Astro.url).href}
  alternates={alternates}
  xDefaultHref="/archives/"
>
  <Header
    locale={locale}
    languageHref={sectionPath(otherLocale(locale), "archives")}
  />
  <Breadcrumb />
  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    {
      posts.length > 0 ? (
        Object.entries(
          getPostsByGroupCondition(posts, post =>
            post.data.pubDatetime.getFullYear()
          )
        )
          .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
          .map(([year, yearGroup]) => (
            <div>
              <span class="text-2xl font-bold">{year}</span>
              <sup class="text-muted-foreground text-sm">
                {yearGroup.length}
              </sup>
              {Object.entries(
                getPostsByGroupCondition(
                  yearGroup,
                  post => post.data.pubDatetime.getMonth() + 1
                )
              )
                .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
                .map(([month, monthGroup]) => (
                  <div class="flex flex-col sm:flex-row">
                    <div class="mt-6 min-w-36 text-lg sm:my-6">
                      <span class="font-bold">
                        {monthFormatter.format(
                          new Date(2000, Number(month) - 1, 1)
                        )}
                      </span>
                      <sup class="text-muted-foreground text-xs">
                        {monthGroup.length}
                      </sup>
                    </div>
                    <ul>
                      {monthGroup.map(data => (
                        <Card {...data} locale={locale} />
                      ))}
                    </ul>
                  </div>
                ))}
            </div>
          ))
      ) : (
        <p class="border-border rounded-xl border p-6">
          {t.post.noPublishedPosts}
        </p>
      )
    }
  </Main>
  <Footer />
</Layout>

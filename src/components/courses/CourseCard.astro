---
import type { CourseCatalog } from "@/courses/catalog";
import { useTranslations } from "@/i18n";
import type { ContentLocale } from "@/i18n/locales";
import { detailPath } from "@/i18n/urls";

const { catalog, locale } = Astro.props as {
  catalog: CourseCatalog;
  locale: ContentLocale;
};
const { course, modules, lessons } = catalog;
const t = useTranslations(locale);
---

<article
  class="border-border h-full min-w-0 rounded-xl border p-5 transition hover:-translate-y-0.5 hover:shadow-lg sm:p-6"
>
  <div class="text-accent mb-2 text-sm font-semibold tracking-wide uppercase">
    {t.course.courseLabel}
  </div>
  <h2 class="text-xl font-semibold wrap-break-word">
    <a
      href={detailPath(locale, "courses", course.data.slug)}
      class="hover:text-accent">{course.data.title}</a
    >
  </h2>
  <p class="mt-3 leading-7 opacity-80">{course.data.description}</p>
  <div class="mt-4 flex flex-wrap gap-2 text-sm">
    {
      course.data.tags.map(tag => (
        <span class="bg-muted rounded-full px-3 py-1">{tag}</span>
      ))
    }
  </div>
  <p class="mt-4 text-sm opacity-70">
    {modules.length}
    {t.course.modules} · {lessons.length}
    {t.course.lessons}
  </p>
</article>

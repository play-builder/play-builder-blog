---
import type { CourseCatalog } from "@/courses/catalog";

const { catalog } = Astro.props as { catalog: CourseCatalog };
const { course, modules, lessons } = catalog;
---

<article
  class="border-border rounded-xl border p-5 transition hover:-translate-y-0.5 hover:shadow-lg"
>
  <div class="text-accent mb-2 text-sm font-semibold tracking-wide uppercase">
    Course
  </div>
  <h2 class="text-xl font-semibold">
    <a href={`/courses/${course.data.slug}/`} class="hover:text-accent"
      >{course.data.title}</a
    >
  </h2>
  <p class="mt-2 opacity-80">{course.data.description}</p>
  <div class="mt-4 flex flex-wrap gap-2 text-sm">
    {
      course.data.tags.map(tag => (
        <span class="bg-muted rounded-full px-3 py-1">{tag}</span>
      ))
    }
  </div>
  <p class="mt-4 text-sm opacity-70">
    {modules.length} modules · {lessons.length} lessons
  </p>
</article>

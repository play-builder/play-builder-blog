---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import { DEFAULT_LOCALE, isContentLocale } from "@/i18n/locales";
import { getRelativeLocaleUrl } from "astro:i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
const requestedLocale = Astro.currentLocale;
const locale = isContentLocale(requestedLocale)
  ? requestedLocale
  : DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div class="my-2 flex flex-col items-center sm:items-start">
      <nav
        aria-label={t.a11y.secondaryNavigation}
        class="mb-2 flex gap-4 text-sm"
      >
        <a class="hover:text-accent" href={getRelativeLocaleUrl(locale, "tags")}
          >{t.nav.tags}</a
        >
        <a
          class="hover:text-accent"
          href={getRelativeLocaleUrl(locale, "archives")}>{t.nav.archives}</a
        >
        <a class="hover:text-accent" href="https://playbuilder.xyz"
          >{t.home.profileWebsite}</a
        >
      </nav>
      <div class="whitespace-nowrap">
        <span>{t.footer.copyright} &#169; {currentYear}</span>
        <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
        <span>{t.footer.allRightsReserved}</span>
      </div>
    </div>
  </div>
</footer>

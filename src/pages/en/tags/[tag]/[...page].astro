---
import type { GetStaticPathsOptions } from "astro";
import TagPage from "@/components/pages/TagPage.astro";
import { getPostsForLocale } from "@/posts/routes";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyAll } from "@/utils/slugify";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPostsForLocale("en");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) =>
    paginate(
      posts.filter(({ data }) => slugifyAll(data.tags).includes(tag)),
      {
        params: { tag },
        props: { tagName },
        pageSize: config.posts.perPage,
      }
    )
  );
}

const { page, tagName } = Astro.props;
const tag = Astro.params.tag ?? "";
---

<TagPage locale="en" {page} {tagName} {tag} />

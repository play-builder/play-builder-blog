---
import type { GetStaticPaths } from "astro";
import PostsPage from "@/components/pages/PostsPage.astro";
import { emptyPostPage, getPostsForLocale } from "@/posts/routes";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPostsForLocale("en");
  return posts.length > 0
    ? paginate(posts, { pageSize: config.posts.perPage })
    : [
        {
          params: { page: undefined },
          props: { page: emptyPostPage("en", config.posts.perPage) },
        },
      ];
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<PostsPage locale="en" page={page} />

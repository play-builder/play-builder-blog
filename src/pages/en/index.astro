---
import HomePage from "@/components/pages/HomePage.astro";
import { getCourseRouteData } from "@/courses/routes";
import { getPostsForLocale } from "@/posts/routes";

const locale = "en" as const;
const [posts, courses] = await Promise.all([
  getPostsForLocale(locale),
  getCourseRouteData(locale),
]);
---

<HomePage locale={locale} posts={posts} courses={courses} />

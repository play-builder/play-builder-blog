---
import type { GetStaticPaths } from "astro";
import CoursePage from "@/components/pages/CoursePage.astro";
import { getCourseRouteData } from "@/courses/routes";

export const getStaticPaths = (async () =>
  (await getCourseRouteData("en")).map(route => ({
    params: { course: route.catalog.course.data.slug },
    props: { route },
  }))) satisfies GetStaticPaths;

const { route } = Astro.props;
---

<CoursePage locale="en" route={route} />

---
import type { GetStaticPaths } from "astro";
import LessonPage from "@/components/pages/LessonPage.astro";
import { getLessonRouteData } from "@/courses/routes";

export const getStaticPaths = (async () =>
  (await getLessonRouteData("en")).map(route => ({
    params: {
      course: route.catalog.course.data.slug,
      lesson: route.lesson.data.slug,
    },
    props: { route },
  }))) satisfies GetStaticPaths;

const { route } = Astro.props;
---

<LessonPage locale="en" route={route} />

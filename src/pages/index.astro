---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import CourseCard from "@/components/courses/CourseCard.astro";
import { buildCourseCatalog } from "@/courses/catalog";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const courseCatalog = buildCourseCatalog(
  await getCollection("courses"),
  await getCollection("lessons")
);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Build systems. Share what works.
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        I build and operate mission-critical infrastructure for blockchain
        networks, cloud-native platforms, and distributed systems. Here I share
        practical lessons from real-world production environments—from
        Kubernetes internals and Linux networking to blockchain node operations
        and Web3 infrastructure.
      </p>
      <p class="mt-2">
        Explore production-focused Tech Posts, follow hands-on Courses, or check
        the
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          About
        </LinkButton> page for more info.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          class="bg-accent text-accent-foreground rounded-lg px-4 py-2 font-semibold"
          href="/posts/">Tech Posts</a
        >
        <a
          class="border-border rounded-lg border px-4 py-2 font-semibold"
          href="/courses/">Courses</a
        >
        <a
          class="border-border rounded-lg border px-4 py-2"
          href="https://playbuilder.xyz">Profile website</a
        >
      </div>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            Latest Tech Posts
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      courseCatalog.length > 0 && (
        <section
          id="published-courses"
          class="border-border border-t pt-12 pb-6"
        >
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold tracking-wide">
              Published Courses
            </h2>
            <a class="hover:text-accent" href="/courses/">
              All Courses →
            </a>
          </div>
          <div class="mt-6 grid gap-5 md:grid-cols-2">
            {courseCatalog.slice(0, 2).map(catalog => (
              <CourseCard {catalog} />
            ))}
          </div>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
